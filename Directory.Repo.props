<Project>
  <!-- Shared by every mod project below d:\Projects\REPO. Used by Linkoid.Repo.Plugin.Build. -->
  <PropertyGroup>
    <GameDirectory>C:\Program Files (x86)\Steam\steamapps\common\REPO\</GameDirectory>
    <ProfileName>ModDev</ProfileName>
    <BepInExDirectory>$(AppData)\r2modmanPlus-local\REPO\profiles\$(ProfileName)\BepInEx</BepInExDirectory>
    <StartArguments>--doorstop-enable true --doorstop-target "$(BepInExDirectory)\core\BepInEx.Preloader.dll"</StartArguments>
  </PropertyGroup>
</Project>
